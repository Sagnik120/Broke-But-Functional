{
  "name": "broke-but-functional",
  "private": true,
  "version": "2.0.0",
  "description": "A Gen Z personal finance simulator: make ₹10,000 last 30 days and see every decision's consequences before you make it.",
  "author": "Sagnik120 (https://github.com/Sagnik120)",
  "license": "MIT",
  "homepage": "https://broke-but-functional-vert.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sagnik120/Broke-But-Functional.git"
  },
  "bugs": {
    "url": "https://github.com/Sagnik120/Broke-But-Functional/issues"
  },
  "keywords": [
    "personal-finance",
    "budgeting",
    "simulator",
    "gen-z",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "pwa",
    "accessibility"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
